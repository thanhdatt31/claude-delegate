#!/usr/bin/env python3
"""cx-delegate: Claude giao việc cho Codex qua `codex app-server` (JSON-RPC stdio) và giám sát.

  cx-delegate run <repo> <plan.md> --allow 'src/**' [--bash-allow 'npm test*'] [--until-idle]
      Chạy một tiến trình điều khiển: in sự kiện ra stdout, tự duyệt hành động trong phạm vi,
      hành động khác in "⚠ CẦN DUYỆT <key>" và chờ lệnh ctl.
  cx-delegate run <repo> --resume "<chỉ dẫn>"     tiếp tục thread cũ với một turn mới
  cx-delegate ctl <repo> approve <key> | deny <key> | steer "<msg>" | interrupt | quit

Trạng thái nằm trong <repo>/.delegate/ (scope.json, cx-state.json, cx-inbox/, cx-server.log).
"""
import argparse
import fnmatch
import json
import os
import queue
import re
import shlex
import subprocess
import sys
import threading
import time
import uuid
from pathlib import Path

CODEX = os.environ.get("CODEX_BIN", "codex")

RULES = """\
Bạn là coder được giao việc. Quy tắc bắt buộc:
1. Nếu có công cụ lập plan thì chép các bước của plan dưới đây vào đó, đúng thứ tự.
2. Làm lần lượt từng bước. Trước mỗi bước, gửi một tin nhắn ngắn dạng "BƯỚC <n>: <việc sẽ làm>".
3. Chỉ sửa file trong phạm vi: {allow}. Sửa file ngoài phạm vi sẽ bị từ chối; nếu thật sự cần thì dừng và giải thích.
4. Không commit, không đổi branch, không cài thêm dependency nếu plan không yêu cầu.
5. Không làm thêm việc ngoài plan. Thấy plan sai hoặc thiếu thì dừng lại và nói rõ, đừng tự ý đổi hướng.
6. Kết thúc bằng báo cáo ngắn: đã làm bước nào, file nào đã sửa, lệnh kiểm tra đã chạy và kết quả, chỗ nào lệch plan.

PLAN:
"""

# Lệnh luôn từ chối, bất kể bash_allow.
DENY_CMDS = ["rm -rf*", "*sudo *", "git push*", "git commit*", "git reset*", "git checkout*",
             "git switch*", "git rebase*", "git clean*", "git stash*"]
# Lệnh chỉ đọc luôn cho phép.
SAFE_CMDS = ["ls*", "pwd", "cat *", "git status*", "git diff*", "git log*", "git show*", "rg *", "grep *",
             "sed -n *", "head *", "tail *", "wc *", "nl *"]


def out(*parts):
    print(time.strftime("%H:%M:%S"), *parts, flush=True)


def short(s, n=160):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[:n] + "…"


def ddir(repo):
    return Path(repo) / ".delegate"


def load(repo, name, default=None):
    p = ddir(repo) / name
    return json.loads(p.read_text()) if p.exists() else default


def save(repo, name, obj):
    ddir(repo).mkdir(exist_ok=True)
    (ddir(repo) / name).write_text(json.dumps(obj, indent=2, ensure_ascii=False))


def exclude_from_git(repo):
    exclude = Path(repo) / ".git/info/exclude"
    if exclude.parent.exists():
        text = exclude.read_text() if exclude.exists() else ""
        if ".delegate/" not in text.split():
            exclude.write_text(text + ("" if text.endswith("\n") or not text else "\n") + ".delegate/\n")


def unwrap_shell(cmd):
    """Codex bọc lệnh thành `/bin/zsh -lc '<lệnh>'`; lấy lại lệnh gốc để so khớp quy tắc."""
    try:
        argv = shlex.split(cmd)
    except ValueError:
        return cmd
    if len(argv) == 3 and Path(argv[0]).name in ("zsh", "bash", "sh") and argv[1] in ("-c", "-lc"):
        return argv[2]
    return cmd


def split_commands(cmd):
    """Tách lệnh ghép theo ; && || | và xuống dòng. Trả về None nếu có cú pháp khó kiểm soát
    (lệnh con lồng, chuyển hướng ghi file) để không bao giờ tự duyệt những lệnh đó."""
    if "$(" in cmd or "`" in cmd or re.search(r"(?<![0-9&])>|>>|<\(", cmd.replace("2>&1", "")):
        return None
    parts = re.split(r"\s*(?:;|&&|\|\||\||\n)\s*", cmd.strip())
    return [p for p in parts if p]


def classify(cmd, allow):
    """'deny' nếu có lệnh con bị cấm, 'allow' nếu mọi lệnh con đều được phép, None nếu cần duyệt."""
    parts = split_commands(cmd)
    segments = parts if parts is not None else [cmd]
    if any(fnmatch.fnmatch(s, g) for s in segments for g in DENY_CMDS):
        return "deny"
    if parts and all(any(fnmatch.fnmatch(s, g) for g in allow) for s in parts):
        return "allow"
    return None


def glob_match(path, globs):
    return any(fnmatch.fnmatch(path, g) or fnmatch.fnmatch(path, g.replace("/**", "")) for g in globs)


def rel(repo, p):
    p = Path(p)
    if not p.is_absolute():
        p = Path(repo) / p
    try:
        return str(p.resolve().relative_to(Path(repo).resolve()))
    except ValueError:
        return "../" + str(p)


class Controller:
    def __init__(self, repo, until_idle):
        self.repo = repo
        self.until_idle = until_idle
        self.scope = load(repo, "scope.json", {})
        self.inbox = ddir(repo) / "cx-inbox"
        self.inbox.mkdir(parents=True, exist_ok=True)
        for f in self.inbox.iterdir():
            f.unlink()
        log = open(ddir(repo) / "cx-server.log", "ab")
        self.proc = subprocess.Popen([CODEX, "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=log, text=True, bufsize=1, cwd=repo)
        self.q = queue.Queue()
        threading.Thread(target=self._reader, daemon=True).start()
        self.next_id = 1
        self.waiting = {}      # request id -> callback cho response
        self.items = {}        # itemId -> item (để biết path của fileChange khi được xin duyệt)
        self.pending = {}      # key -> (jsonrpc id, method, mô tả) chờ Claude quyết
        self.thread_id = None
        self.turn_id = None
        self.done = False

    # ---------- JSON-RPC ----------
    def _reader(self):
        for line in self.proc.stdout:
            try:
                self.q.put(json.loads(line))
            except json.JSONDecodeError:
                pass
        self.q.put(None)

    def send(self, msg):
        self.proc.stdin.write(json.dumps(msg) + "\n")
        self.proc.stdin.flush()

    def request(self, method, params, cb=None):
        i = self.next_id
        self.next_id += 1
        self.waiting[i] = cb
        self.send({"method": method, "id": i, "params": params})
        return i

    def call(self, method, params, timeout=60):
        """Gọi đồng bộ, vẫn xử lý các message khác trong lúc chờ."""
        box = {}
        self.request(method, params, lambda m: box.setdefault("m", m))
        end = time.time() + timeout
        while "m" not in box:
            if time.time() > end:
                sys.exit(f"timeout chờ {method}")
            self.pump(0.2)
        if "error" in box["m"]:
            sys.exit(f"{method} lỗi: {box['m']['error']}")
        return box["m"].get("result")

    def reply(self, req_id, result):
        self.send({"id": req_id, "result": result})

    # ---------- vòng lặp ----------
    def pump(self, timeout):
        try:
            m = self.q.get(timeout=timeout)
        except queue.Empty:
            return
        if m is None:
            out("‼ codex app-server đã thoát")
            self.done = True
            return
        if "id" in m and "method" not in m:
            cb = self.waiting.pop(m["id"], None)
            if cb:
                cb(m)
            elif "error" in m:
                out(f"‼ lỗi: {short(m['error'], 300)}")
        elif "id" in m:
            self.on_server_request(m)
        else:
            self.on_notification(m["method"], m.get("params", {}))

    def loop(self):
        while not self.done:
            self.pump(0.3)
            self.check_inbox()

    # ---------- xử lý sự kiện ----------
    def on_notification(self, method, p):
        if method == "turn/started":
            self.turn_id = p["turn"]["id"]
        elif method == "turn/plan/updated":
            mark = {"completed": "✔", "inProgress": "▶", "pending": "·"}
            lines = "\n".join(f"         {mark.get(s['status'], '?')} {s['step']}" for s in p.get("plan", []))
            out("PLAN\n" + lines)
        elif method == "item/started":
            item = p["item"]
            self.items[item["id"]] = item
            t = item["type"]
            if t == "commandExecution":
                out(f"→ bash: {short(unwrap_shell(item.get('command') or ''))}")
            elif t == "fileChange":
                paths = [rel(self.repo, c["path"]) for c in item.get("changes", [])]
                out(f"→ sửa file: {', '.join(paths)}")
            elif t in ("mcpToolCall", "dynamicToolCall"):
                out(f"→ tool {item.get('tool')}")
            elif t == "webSearch":
                out(f"→ web search: {short(item.get('query'))}")
        elif method == "item/completed":
            item = p["item"]
            self.items[item["id"]] = item
            t = item["type"]
            if t == "commandExecution" and item.get("exitCode") not in (0, None):
                out(f"✘ bash exit {item.get('exitCode')}: {short(item.get('aggregatedOutput', ''), 300)}")
            elif t == "fileChange" and item.get("status") == "completed":
                bad = [x for x in (rel(self.repo, c["path"]) for c in item.get("changes", [])) if not self.in_scope(x)]
                if bad:
                    # Lớp dự phòng: lần sửa ngoài phạm vi đã được ghi mà không qua bước duyệt.
                    out(f"‼ đã sửa ngoài phạm vi mà không qua duyệt: {bad} — dừng turn")
                    self.interrupt()
            elif t == "fileChange" and item.get("status") not in ("completed", None):
                out(f"✘ sửa file {item.get('status')}")
            elif t == "agentMessage":
                self.last_message = item.get("text", "")
                if item.get("phase") != "final_answer":
                    out(f"💬 {short(self.last_message, 200)}")
        elif method == "turn/completed":
            turn = p.get("turn", {})
            out(f"■ turn kết thúc ({turn.get('status')}). Báo cáo cuối:\n" + getattr(self, "last_message", ""))
            self.turn_id = None
            if self.until_idle:
                self.done = True
        elif method == "error":
            out(f"‼ lỗi: {short(json.dumps(p, ensure_ascii=False), 400)}")

    def in_scope(self, path):
        return (not path.startswith("..") and glob_match(path, self.scope.get("allow", []))
                and not glob_match(path, self.scope.get("deny", [])))

    def on_server_request(self, m):
        method, p, rid = m["method"], m.get("params", {}), m["id"]
        if method in ("item/fileChange/requestApproval", "applyPatchApproval"):
            item = self.items.get(p.get("itemId"), {})
            paths = [rel(self.repo, c["path"]) for c in item.get("changes", [])]
            if paths and all(self.in_scope(x) for x in paths):
                self.reply(rid, {"decision": "accept"})
                out(f"✓ tự duyệt sửa {', '.join(paths)}")
            elif paths:
                self.reply(rid, {"decision": "decline"})
                out(f"✘ từ chối sửa ngoài phạm vi: {', '.join(paths)}")
            else:
                self.escalate(rid, method, f"sửa file (không rõ path) {short(p.get('reason'))}")
        elif method in ("item/commandExecution/requestApproval", "execCommandApproval"):
            cmd = p.get("command") or ""
            if isinstance(cmd, list):
                cmd = shlex.join(cmd)
            cmd = unwrap_shell(cmd)
            verdict = classify(cmd, SAFE_CMDS + self.scope.get("bash_allow", []))
            if verdict == "deny":
                self.reply(rid, {"decision": "decline"})
                out(f"✘ từ chối lệnh cấm: {short(cmd)}")
            elif verdict == "allow":
                self.reply(rid, {"decision": "accept"})
                out(f"✓ tự duyệt bash {short(cmd)}")
            else:
                reason = f" (lý do: {short(p.get('reason'), 120)})" if p.get("reason") else ""
                self.escalate(rid, method, f"bash {short(cmd, 200)}{reason}")
        else:
            self.escalate(rid, method, short(json.dumps(p, ensure_ascii=False), 300))

    def escalate(self, rid, method, desc):
        key = uuid.uuid4().hex[:6]
        self.pending[key] = (rid, method, desc)
        out(f"⚠ CẦN DUYỆT {key}: {desc}")

    # ---------- điều khiển từ Claude ----------
    def check_inbox(self):
        for f in sorted(self.inbox.iterdir()):
            try:
                cmd = json.loads(f.read_text())
            except Exception:
                continue
            finally:
                f.unlink(missing_ok=True)
            self.handle_cmd(cmd)

    def handle_cmd(self, c):
        op = c.get("op")
        if op in ("approve", "deny"):
            entry = self.pending.pop(c["key"], None)
            if not entry:
                out(f"không có yêu cầu {c['key']}")
                return
            rid, method, desc = entry
            if method.endswith("requestApproval") or method in ("applyPatchApproval", "execCommandApproval"):
                self.reply(rid, {"decision": "accept" if op == "approve" else "decline"})
            else:
                self.send({"id": rid, "error": {"code": -32000, "message": "declined by controller"}})
            out(f"{'✓ đã duyệt' if op == 'approve' else '✘ đã từ chối'} {c['key']}: {desc}")
        elif op == "steer":
            if not self.turn_id:
                out("không có turn đang chạy để steer")
                return
            self.request("turn/steer", {"threadId": self.thread_id, "expectedTurnId": self.turn_id,
                                        "input": [{"type": "text", "text": c["text"]}]})
            out(f"↪ steer: {short(c['text'])}")
        elif op == "interrupt":
            self.interrupt()
        elif op == "quit":
            self.done = True

    def interrupt(self):
        if self.turn_id:
            self.request("turn/interrupt", {"threadId": self.thread_id, "turnId": self.turn_id})
            out("⏹ đã gửi interrupt")


def cmd_run(a):
    repo = str(Path(a.repo).resolve())
    if a.resume:
        st = load(repo, "cx-state.json") or sys.exit("chưa có thread để resume")
        text = a.resume
    else:
        if not a.plan or not a.allow:
            sys.exit("cần plan và ít nhất một --allow")
        save(repo, "scope.json", {"allow": a.allow, "deny": a.deny, "bash_allow": a.bash_allow})
        exclude_from_git(repo)
        text = RULES.format(allow=", ".join(a.allow)) + Path(a.plan).read_text()
    c = Controller(repo, a.until_idle)
    c.call("initialize", {"clientInfo": {"name": "cx-delegate", "title": "cx-delegate", "version": "0.1"}})
    c.send({"method": "initialized"})
    if a.resume:
        c.thread_id = c.call("thread/resume", {"threadId": st["thread"]})["thread"]["id"]
        model, effort = st["model"], st["effort"]
    else:
        model, effort = a.model, a.effort
        r = c.call("thread/start", {"cwd": repo, "model": model, "sandbox": "workspace-write",
                                    "approvalPolicy": "untrusted"})
        c.thread_id = r["thread"]["id"]
        save(repo, "cx-state.json", {"thread": c.thread_id, "model": model, "effort": effort, "started": time.time()})
    c.call("turn/start", {"threadId": c.thread_id, "effort": effort, "summary": "concise",
                          "input": [{"type": "text", "text": text}]})
    out(f"đã giao việc: thread={c.thread_id} model={model}/{effort} scope={load(repo, 'scope.json')['allow']}")
    try:
        c.loop()
    finally:
        c.proc.terminate()


def cmd_ctl(a):
    repo = str(Path(a.repo).resolve())
    inbox = ddir(repo) / "cx-inbox"
    if not inbox.exists():
        sys.exit("không có controller nào đang chạy cho repo này")
    cmd = {"op": a.op}
    if a.op in ("approve", "deny"):
        cmd["key"] = a.arg
    elif a.op == "steer":
        cmd["text"] = a.arg
    (inbox / f"{time.time_ns()}.json").write_text(json.dumps(cmd, ensure_ascii=False))
    print("đã gửi", a.op)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("repo"); r.add_argument("plan", nargs="?")
    r.add_argument("--allow", action="append", default=[])
    r.add_argument("--deny", action="append", default=[])
    r.add_argument("--bash-allow", action="append", default=[])
    r.add_argument("--model", default="gpt-6.1-sol")
    r.add_argument("--effort", default="high")
    r.add_argument("--resume", metavar="MSG")
    r.add_argument("--until-idle", action="store_true")
    r.set_defaults(fn=cmd_run)
    c = sub.add_parser("ctl")
    c.add_argument("repo")
    c.add_argument("op", choices=["approve", "deny", "steer", "interrupt", "quit"])
    c.add_argument("arg", nargs="?")
    c.set_defaults(fn=cmd_ctl)
    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
