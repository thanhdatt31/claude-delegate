#!/usr/bin/env python3
"""cx-worker: Claude giao việc bất kỳ cho Codex (worker) qua `codex app-server` và giám sát.

  cx-worker run <dir> <task.md> [--name N] [--mode read|edit] [--allow GLOB]... [--deny GLOB]...
                [--bash-allow PATTERN]... [--network] [--schema FILE|none] [--model M] [--effort E]
      Chạy một tiến trình điều khiển cho worker N: in sự kiện ra stdout, tự duyệt hành động an toàn,
      hành động khác in "⚠ CẦN DUYỆT <key>" và chờ lệnh ctl. Kết thúc khi worker xong turn.
  cx-worker resume <dir> --name N "<chỉ dẫn>"      thêm một turn vào thread cũ (giữ ngữ cảnh)
  cx-worker ctl <dir> --name N approve <key> | deny <key> | steer "<msg>" | interrupt | quit
  cx-worker result <dir> --name N                  in kết quả cuối (JSON nếu có schema)
  cx-worker list [<dir>]                           liệt kê worker và trạng thái
  cx-worker restore <dir> --name N                 khôi phục file trong phạm vi về lúc trước khi giao

Mode:
  read  sandbox chỉ đọc, không sửa được gì. Hợp cho điều tra, phân tích, review, nghiên cứu.
  edit  sandbox ghi trong <dir>; mỗi lần sửa file phải nằm trong --allow, ngoài phạm vi bị từ chối.
--network bật tìm web (live) và cho lệnh trong sandbox truy cập mạng.

Trạng thái nằm ngoài <dir>: ${XDG_STATE_HOME:-~/.local/state}/cx-worker/<dir-slug>/<name>/.
"""
import argparse
import fnmatch
import hashlib
import json
import os
import queue
import re
import shlex
import shutil
import subprocess
import sys
import threading
import time
import uuid
from pathlib import Path

CODEX = os.environ.get("CODEX_BIN", "codex")
STATE_ROOT = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "cx-worker"
SNAPSHOT_LIMIT = 200 * 1024 * 1024

RULES = """\
Bạn là worker được Claude giao việc. Quy tắc bắt buộc:
1. Làm đúng nhiệm vụ dưới đây, không làm thêm. Nhiệm vụ sai, thiếu hoặc mơ hồ thì dừng và nêu rõ (status "blocked").
2. Làm lần lượt. Trước mỗi bước lớn, gửi một tin nhắn ngắn dạng "BƯỚC <n>: <việc sẽ làm>".
3. {scope_rule}
4. Không commit, không đổi branch, không cài đặt gì nếu nhiệm vụ không yêu cầu.
5. Mọi khẳng định phải có bằng chứng: đường dẫn file:dòng, output lệnh, hoặc URL nguồn.
6. {output_rule}

NHIỆM VỤ:
"""

DEFAULT_SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "required": ["status", "summary", "findings", "files_changed", "checks", "sources", "deviations", "next_steps"],
    "properties": {
        "status": {"type": "string", "enum": ["done", "partial", "blocked"]},
        "summary": {"type": "string", "description": "Tóm tắt kết quả, 1-5 câu"},
        "findings": {"type": "array", "items": {
            "type": "object", "additionalProperties": False, "required": ["title", "detail", "evidence"],
            "properties": {"title": {"type": "string"}, "detail": {"type": "string"},
                           "evidence": {"type": "string", "description": "file:dòng, output lệnh hoặc URL"}}}},
        "files_changed": {"type": "array", "items": {"type": "string"}},
        "checks": {"type": "array", "items": {
            "type": "object", "additionalProperties": False, "required": ["check", "result"],
            "properties": {"check": {"type": "string"}, "result": {"type": "string"}}}},
        "sources": {"type": "array", "items": {"type": "string"}},
        "deviations": {"type": "array", "items": {"type": "string"}, "description": "Chỗ lệch nhiệm vụ và lý do"},
        "next_steps": {"type": "array", "items": {"type": "string"}},
    },
}

# Lệnh luôn từ chối, bất kể bash_allow.
DENY_CMDS = ["rm -rf*", "rm -fr*", "*sudo *", "git push*", "git commit*", "git reset*", "git checkout*",
             "git switch*", "git rebase*", "git clean*", "git stash*"]
# Lệnh chỉ đọc luôn cho phép.
SAFE_CMDS = ["ls*", "pwd", "cat *", "git status*", "git diff*", "git log*", "git show*", "git ls-files*",
             "rg *", "grep *", "sed -n *", "head *", "tail *", "wc *", "nl *", "file *", "stat *", "du *",
             "tree*", "which *", "echo *", "date*", "uname*", "jq *"]


# ---------- tiện ích ----------

def out(*parts):
    print(time.strftime("%H:%M:%S"), *parts, flush=True)


def short(s, n=160):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[:n] + "…"


def wdir(target, name):
    target = str(Path(target).resolve())
    slug = re.sub(r"[^A-Za-z0-9._-]+", "_", Path(target).name)[:40] + "-" + hashlib.sha1(target.encode()).hexdigest()[:8]
    return STATE_ROOT / slug / name


def load(d, name, default=None):
    p = d / name
    return json.loads(p.read_text()) if p.exists() else default


def save(d, name, obj):
    d.mkdir(parents=True, exist_ok=True)
    (d / name).write_text(json.dumps(obj, indent=2, ensure_ascii=False))


def unwrap_shell(cmd):
    """Codex bọc lệnh thành `/bin/zsh -lc '<lệnh>'`; lấy lại lệnh gốc để so khớp quy tắc."""
    try:
        argv = shlex.split(cmd)
    except ValueError:
        return cmd
    if len(argv) == 3 and Path(argv[0]).name in ("zsh", "bash", "sh") and argv[1] in ("-c", "-lc"):
        return argv[2]
    return cmd


def split_commands(cmd):
    """Tách lệnh ghép theo ; && || | và xuống dòng. Trả về None nếu có cú pháp khó kiểm soát
    (lệnh con lồng, chuyển hướng ghi file) để không bao giờ tự duyệt những lệnh đó."""
    # Heredoc (`python3 - <<'PY' ... PY`): thân heredoc là dữ liệu stdin của lệnh, không phải lệnh shell,
    # nên chỉ kiểm tra dòng mở đầu và phần nằm sau dòng kết thúc.
    m = re.search(r"<<-?\s*(['\"]?)(\w+)\1", cmd)
    if m:
        head, _, body = cmd.partition("\n")
        lines = body.split("\n")
        end = next((i for i, line in enumerate(lines) if line.strip() == m.group(2)), None)
        if end is None:
            return None
        rest = "\n".join(lines[end + 1:])
        head = head[:m.start()] + head[m.end():]
        first, others = split_commands(head), split_commands(rest) if rest.strip() else []
        return None if first is None or others is None else first + others
    if "$(" in cmd or "`" in cmd or re.search(r"(?<![0-9&])>|>>|<\(", cmd.replace("2>&1", "")):
        return None
    parts = re.split(r"\s*(?:;|&&|\|\||\||\n)\s*", cmd.strip())
    return [p for p in parts if p]


def classify(cmd, allow):
    """'deny' nếu có lệnh con bị cấm, 'allow' nếu mọi lệnh con đều được phép, None nếu cần duyệt."""
    parts = split_commands(cmd)
    segments = parts if parts is not None else [cmd]
    if any(fnmatch.fnmatch(s, g) for s in segments for g in DENY_CMDS):
        return "deny"
    if parts and all(any(fnmatch.fnmatch(s, g) for g in allow) for s in parts):
        return "allow"
    return None


def glob_match(path, globs):
    return any(fnmatch.fnmatch(path, g) or fnmatch.fnmatch(path, g.replace("/**", "")) for g in globs)


def rel(root, p):
    p = Path(p)
    if not p.is_absolute():
        p = Path(root) / p
    try:
        return str(p.resolve().relative_to(Path(root).resolve()))
    except ValueError:
        return "../" + str(p)


# ---------- snapshot cho mode edit ----------

def take_snapshot(target, d, allow, deny):
    snap = d / "snapshot"
    shutil.rmtree(snap, ignore_errors=True)
    files, total = [], 0
    for root, dirs, names in os.walk(target):
        dirs[:] = [x for x in dirs if x not in (".git", "node_modules", ".venv", "__pycache__")]
        for n in names:
            r = rel(target, os.path.join(root, n))
            if glob_match(r, allow) and not glob_match(r, deny):
                total += os.path.getsize(os.path.join(root, n))
                files.append(r)
    if total > SNAPSHOT_LIMIT:
        out(f"⚠ phạm vi quá lớn ({total // 1024 // 1024}MB), bỏ qua snapshot; hãy dùng git để khôi phục")
        return
    for r in files:
        (snap / r).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(Path(target) / r, snap / r)
    save(d, "snapshot.json", {"files": files, "allow": allow, "deny": deny, "time": time.time()})


# ---------- controller ----------

class Controller:
    def __init__(self, target, d, scope):
        self.target, self.d, self.scope = target, d, scope
        self.inbox = d / "inbox"
        self.inbox.mkdir(parents=True, exist_ok=True)
        for f in self.inbox.iterdir():
            f.unlink()
        log = open(d / "server.log", "ab")
        self.proc = subprocess.Popen([CODEX, "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=log, text=True, bufsize=1, cwd=target)
        self.q = queue.Queue()
        threading.Thread(target=self._reader, daemon=True).start()
        self.next_id = 1
        self.waiting = {}      # request id -> callback cho response
        self.items = {}        # itemId -> item (để biết path của fileChange khi được xin duyệt)
        self.pending = {}      # key -> (jsonrpc id, method, mô tả) chờ Claude quyết
        self.thread_id = None
        self.turn_id = None
        self.last_message = ""
        self.done = False

    # ---------- JSON-RPC ----------
    def _reader(self):
        for line in self.proc.stdout:
            try:
                self.q.put(json.loads(line))
            except json.JSONDecodeError:
                pass
        self.q.put(None)

    def send(self, msg):
        self.proc.stdin.write(json.dumps(msg) + "\n")
        self.proc.stdin.flush()

    def request(self, method, params, cb=None):
        i = self.next_id
        self.next_id += 1
        self.waiting[i] = cb
        self.send({"method": method, "id": i, "params": params})
        return i

    def call(self, method, params, timeout=60):
        """Gọi đồng bộ, vẫn xử lý các message khác trong lúc chờ."""
        box = {}
        self.request(method, params, lambda m: box.setdefault("m", m))
        end = time.time() + timeout
        while "m" not in box:
            if time.time() > end or self.done:
                sys.exit(f"không nhận được phản hồi cho {method}, xem {self.d / 'server.log'}")
            self.pump(0.2)
        if "error" in box["m"]:
            sys.exit(f"{method} lỗi: {box['m']['error']}")
        return box["m"].get("result")

    def reply(self, req_id, result):
        self.send({"id": req_id, "result": result})

    # ---------- vòng lặp ----------
    def pump(self, timeout):
        try:
            m = self.q.get(timeout=timeout)
        except queue.Empty:
            return
        if m is None:
            out("‼ codex app-server đã thoát")
            self.done = True
            return
        if "id" in m and "method" not in m:
            cb = self.waiting.pop(m["id"], None)
            if cb:
                cb(m)
            elif "error" in m:
                out(f"‼ lỗi: {short(m['error'], 300)}")
        elif "id" in m:
            self.on_server_request(m)
        else:
            self.on_notification(m["method"], m.get("params", {}))

    def loop(self):
        while not self.done:
            self.pump(0.3)
            self.check_inbox()

    # ---------- xử lý sự kiện ----------
    def on_notification(self, method, p):
        if method == "turn/started":
            self.turn_id = p["turn"]["id"]
            self.status("running")
        elif method == "turn/plan/updated":
            mark = {"completed": "✔", "inProgress": "▶", "pending": "·"}
            lines = "\n".join(f"         {mark.get(s['status'], '?')} {s['step']}" for s in p.get("plan", []))
            out("PLAN\n" + lines)
        elif method == "item/started":
            item = p["item"]
            self.items[item["id"]] = item
            t = item["type"]
            if t == "commandExecution":
                out(f"→ bash: {short(unwrap_shell(item.get('command') or ''))}")
            elif t == "fileChange":
                out(f"→ sửa file: {', '.join(rel(self.target, c['path']) for c in item.get('changes', []))}")
            elif t in ("mcpToolCall", "dynamicToolCall"):
                out(f"→ tool {item.get('tool')}")
        elif method == "item/completed":
            item = p["item"]
            self.items[item["id"]] = item
            t = item["type"]
            if t == "commandExecution" and item.get("exitCode") not in (0, None):
                out(f"✘ bash exit {item.get('exitCode')}: {short(item.get('aggregatedOutput', ''), 300)}")
            elif t == "fileChange" and item.get("status") == "completed":
                bad = [x for x in (rel(self.target, c["path"]) for c in item.get("changes", [])) if not self.in_scope(x)]
                if bad:
                    # Lớp dự phòng: lần sửa ngoài phạm vi đã được ghi mà không qua bước duyệt.
                    out(f"‼ đã sửa ngoài phạm vi mà không qua duyệt: {bad} — dừng turn")
                    self.interrupt()
            elif t == "fileChange" and item.get("status") not in ("completed", None):
                out(f"✘ sửa file {item.get('status')}")
            elif t == "webSearch":
                q = item.get("query") or (item.get("action") or {}).get("query") or ""
                out(f"→ tìm web: {short(q)}")
            elif t == "agentMessage":
                self.last_message = item.get("text", "")
                if item.get("phase") != "final_answer":
                    out(f"💬 {short(self.last_message, 200)}")
        elif method == "turn/completed":
            status = p.get("turn", {}).get("status")
            self.finish(status)
        elif method == "error":
            out(f"‼ lỗi: {short(json.dumps(p, ensure_ascii=False), 400)}")

    def finish(self, status):
        text = self.last_message
        result = None
        try:
            result = json.loads(text)
        except (json.JSONDecodeError, TypeError):
            pass
        save(self.d, "result.json", {"turn_status": status, "result": result, "text": None if result else text})
        self.status(status or "completed")
        body = json.dumps(result, indent=2, ensure_ascii=False) if result else text
        out(f"■ worker xong turn ({status}). Kết quả:\n{body}")
        self.turn_id = None
        self.done = True

    def status(self, s):
        st = load(self.d, "state.json", {})
        st.update({"status": s, "updated": time.time(), "pid": os.getpid()})
        save(self.d, "state.json", st)

    def in_scope(self, path):
        return (self.scope["mode"] == "edit" and not path.startswith("..")
                and glob_match(path, self.scope.get("allow", [])) and not glob_match(path, self.scope.get("deny", [])))

    def on_server_request(self, m):
        method, p, rid = m["method"], m.get("params", {}), m["id"]
        if method in ("item/fileChange/requestApproval", "applyPatchApproval"):
            item = self.items.get(p.get("itemId"), {})
            paths = [rel(self.target, c["path"]) for c in item.get("changes", [])]
            if paths and all(self.in_scope(x) for x in paths):
                self.reply(rid, {"decision": "accept"})
                out(f"✓ tự duyệt sửa {', '.join(paths)}")
            elif paths:
                self.reply(rid, {"decision": "decline"})
                out(f"✘ từ chối sửa ngoài phạm vi: {', '.join(paths)}")
            else:
                self.escalate(rid, method, f"sửa file (không rõ path) {short(p.get('reason'))}")
        elif method in ("item/commandExecution/requestApproval", "execCommandApproval"):
            cmd = p.get("command") or ""
            if isinstance(cmd, list):
                cmd = shlex.join(cmd)
            cmd = unwrap_shell(cmd)
            verdict = classify(cmd, SAFE_CMDS + self.scope.get("bash_allow", []))
            if verdict == "deny":
                self.reply(rid, {"decision": "decline"})
                out(f"✘ từ chối lệnh cấm: {short(cmd)}")
            elif verdict == "allow" and not p.get("networkApprovalContext"):
                self.reply(rid, {"decision": "accept"})
                out(f"✓ tự duyệt bash {short(cmd)}")
            else:
                reason = f" (lý do: {short(p.get('reason'), 120)})" if p.get("reason") else ""
                self.escalate(rid, method, f"bash {short(cmd, 200)}{reason}")
        else:
            self.escalate(rid, method, short(json.dumps(p, ensure_ascii=False), 300))

    def escalate(self, rid, method, desc):
        key = uuid.uuid4().hex[:6]
        self.pending[key] = (rid, method, desc)
        self.status("waiting-approval")
        out(f"⚠ CẦN DUYỆT {key}: {desc}")

    # ---------- điều khiển từ Claude ----------
    def check_inbox(self):
        for f in sorted(self.inbox.iterdir()):
            try:
                cmd = json.loads(f.read_text())
            except Exception:
                continue
            finally:
                f.unlink(missing_ok=True)
            self.handle_cmd(cmd)

    def handle_cmd(self, c):
        op = c.get("op")
        if op in ("approve", "deny"):
            entry = self.pending.pop(c["key"], None)
            if not entry:
                out(f"không có yêu cầu {c['key']}")
                return
            rid, method, desc = entry
            if method.endswith("requestApproval") or method in ("applyPatchApproval", "execCommandApproval"):
                self.reply(rid, {"decision": "accept" if op == "approve" else "decline"})
            else:
                self.send({"id": rid, "error": {"code": -32000, "message": "declined by controller"}})
            if not self.pending:
                self.status("running")
            out(f"{'✓ đã duyệt' if op == 'approve' else '✘ đã từ chối'} {c['key']}: {desc}")
        elif op == "steer":
            if not self.turn_id:
                out("không có turn đang chạy để steer")
                return
            self.request("turn/steer", {"threadId": self.thread_id, "expectedTurnId": self.turn_id,
                                        "input": [{"type": "text", "text": c["text"]}]})
            out(f"↪ steer: {short(c['text'])}")
        elif op == "interrupt":
            self.interrupt()
        elif op == "quit":
            self.status("quit")
            self.done = True

    def interrupt(self):
        if self.turn_id:
            self.request("turn/interrupt", {"threadId": self.thread_id, "turnId": self.turn_id})
            out("⏹ đã gửi interrupt")


def thread_config(scope):
    cfg = {"web_search": "live" if scope["network"] else "disabled"}
    if scope["mode"] == "edit":
        cfg["sandbox_workspace_write"] = {"network_access": scope["network"]}
    return cfg


def start_controller(target, d, scope):
    c = Controller(target, d, scope)
    c.call("initialize", {"clientInfo": {"name": "cx-worker", "title": "cx-worker", "version": "0.2"}})
    c.send({"method": "initialized"})
    return c


def turn_params(c, st, text):
    params = {"threadId": c.thread_id, "effort": st["effort"], "summary": "concise",
              "input": [{"type": "text", "text": text}]}
    if st.get("schema"):
        params["outputSchema"] = st["schema"]
    return params


def run_loop(c):
    try:
        c.loop()
    finally:
        c.proc.terminate()


def cmd_run(a):
    target = str(Path(a.dir).resolve())
    d = wdir(target, a.name)
    st = load(d, "state.json")
    if st and st.get("status") in ("running", "waiting-approval") and pid_alive(st.get("pid")):
        sys.exit(f"worker '{a.name}' đang chạy cho {target}; dùng --name khác hoặc ctl quit")
    if a.mode == "edit" and not a.allow:
        sys.exit("mode edit cần ít nhất một --allow")
    task = sys.stdin.read() if a.task == "-" else Path(a.task).read_text()
    if a.schema == "none":
        schema = None
    elif a.schema:
        schema = json.loads(Path(a.schema).read_text())
    else:
        schema = DEFAULT_SCHEMA
    scope = {"mode": a.mode, "allow": a.allow, "deny": a.deny, "bash_allow": a.bash_allow, "network": a.network}
    shutil.rmtree(d, ignore_errors=True)
    save(d, "scope.json", scope)
    (d / "task.md").write_text(task)
    if a.mode == "edit":
        take_snapshot(target, d, a.allow, a.deny)
    scope_rule = ("Đây là việc CHỈ ĐỌC: không tạo, sửa hay xoá file nào." if a.mode == "read" else
                  f"Chỉ sửa file trong phạm vi: {', '.join(a.allow)}. Sửa ngoài phạm vi sẽ bị từ chối; nếu thật sự cần thì dừng và giải thích.")
    output_rule = ("Câu trả lời cuối cùng phải là JSON đúng schema được cung cấp, không thêm chữ nào ngoài JSON." if schema else
                   "Kết thúc bằng báo cáo ngắn: đã làm gì, bằng chứng, kiểm tra đã chạy, chỗ nào lệch nhiệm vụ.")
    text = RULES.format(scope_rule=scope_rule, output_rule=output_rule) + task

    c = start_controller(target, d, scope)
    r = c.call("thread/start", {
        "cwd": target, "model": a.model,
        "sandbox": "read-only" if a.mode == "read" else "workspace-write",
        # read: sandbox chỉ đọc đã chặn mọi thao tác ghi, nên không cần duyệt từng lệnh.
        "approvalPolicy": "never" if a.mode == "read" else "untrusted", "config": thread_config(scope)})
    c.thread_id = r["thread"]["id"]
    st = {"thread": c.thread_id, "target": target, "name": a.name, "model": a.model, "effort": a.effort,
          "mode": a.mode, "schema": schema, "started": time.time()}
    save(d, "state.json", st)
    c.call("turn/start", turn_params(c, st, text))
    net = " +network" if a.network else ""
    scope_desc = "chỉ đọc" if a.mode == "read" else f"sửa {a.allow}"
    out(f"đã giao việc cho worker '{a.name}': {a.model}/{a.effort}, {scope_desc}{net}, thread={c.thread_id}")
    run_loop(c)


def cmd_resume(a):
    target = str(Path(a.dir).resolve())
    d = wdir(target, a.name)
    st = load(d, "state.json") or sys.exit(f"không có worker '{a.name}' cho {target}")
    if st.get("status") in ("running", "waiting-approval") and pid_alive(st.get("pid")):
        sys.exit(f"worker '{a.name}' đang chạy; dùng ctl steer thay vì resume")
    scope = load(d, "scope.json")
    c = start_controller(target, d, scope)
    c.thread_id = c.call("thread/resume", {"threadId": st["thread"], "config": thread_config(scope)})["thread"]["id"]
    text = a.message
    if st.get("schema"):
        text += "\n\n(Câu trả lời cuối cùng vẫn phải là JSON đúng schema.)"
    c.call("turn/start", turn_params(c, st, text))
    out(f"đã gửi turn mới cho worker '{a.name}'")
    run_loop(c)


def cmd_ctl(a):
    d = wdir(a.dir, a.name)
    inbox = d / "inbox"
    st = load(d, "state.json") or {}
    if not inbox.exists() or not pid_alive(st.get("pid")):
        sys.exit(f"worker '{a.name}' không chạy")
    cmd = {"op": a.op}
    if a.op in ("approve", "deny"):
        cmd["key"] = a.arg
    elif a.op == "steer":
        cmd["text"] = a.arg
    (inbox / f"{time.time_ns()}.json").write_text(json.dumps(cmd, ensure_ascii=False))
    print("đã gửi", a.op)


def cmd_result(a):
    r = load(wdir(a.dir, a.name), "result.json") or sys.exit("chưa có kết quả")
    print(json.dumps(r["result"], indent=2, ensure_ascii=False) if r.get("result") else r.get("text", ""))


def cmd_list(a):
    roots = [wdir(a.dir, "x").parent] if a.dir else sorted(STATE_ROOT.glob("*")) if STATE_ROOT.exists() else []
    for root in roots:
        for d in sorted(root.glob("*")):
            st = load(d, "state.json") or {}
            status = st.get("status", "?")
            if status in ("running", "waiting-approval") and not pid_alive(st.get("pid")):
                status = "dead"
            when = time.strftime("%m-%d %H:%M", time.localtime(st.get("updated", st.get("started", 0))))
            print(f"{st.get('name', d.name):16} {status:17} {st.get('mode', '?'):5} {when}  {st.get('target', '')}")


def cmd_restore(a):
    target = str(Path(a.dir).resolve())
    d = wdir(target, a.name)
    meta = load(d, "snapshot.json") or sys.exit("worker này không có snapshot (mode read, hoặc phạm vi quá lớn)")
    snap = d / "snapshot"
    restored, removed = 0, 0
    for r in meta["files"]:
        dst = Path(target) / r
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(snap / r, dst)
        restored += 1
    keep = set(meta["files"])
    for root, dirs, names in os.walk(target):
        dirs[:] = [x for x in dirs if x not in (".git", "node_modules", ".venv")]
        for n in names:
            r = rel(target, os.path.join(root, n))
            if r not in keep and glob_match(r, meta["allow"]) and not glob_match(r, meta["deny"]):
                os.remove(os.path.join(root, n))
                removed += 1
    print(f"đã khôi phục {restored} file, xoá {removed} file mới tạo trong phạm vi")


def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="giao việc cho một worker")
    r.add_argument("dir"); r.add_argument("task", help="file mô tả nhiệm vụ, hoặc - để đọc stdin")
    r.add_argument("--name", default="main")
    r.add_argument("--mode", choices=["read", "edit"], default="read")
    r.add_argument("--allow", action="append", default=[], help="glob file được sửa (mode edit)")
    r.add_argument("--deny", action="append", default=[], help="glob file cấm sửa")
    r.add_argument("--bash-allow", action="append", default=[], help="lệnh tự duyệt, vd 'npm test*'")
    r.add_argument("--network", action="store_true", help="bật tìm web và mạng trong sandbox")
    r.add_argument("--schema", help="file JSON Schema cho kết quả; 'none' để trả lời tự do")
    r.add_argument("--model", default="gpt-6.1-sol")
    r.add_argument("--effort", default="high")
    r.set_defaults(fn=cmd_run)

    p = sub.add_parser("resume", help="thêm một turn vào thread cũ")
    p.add_argument("dir"); p.add_argument("message"); p.add_argument("--name", default="main")
    p.set_defaults(fn=cmd_resume)

    p = sub.add_parser("ctl", help="điều khiển worker đang chạy")
    p.add_argument("dir"); p.add_argument("op", choices=["approve", "deny", "steer", "interrupt", "quit"])
    p.add_argument("arg", nargs="?"); p.add_argument("--name", default="main")
    p.set_defaults(fn=cmd_ctl)

    for name, fn in [("result", cmd_result), ("restore", cmd_restore)]:
        p = sub.add_parser(name); p.add_argument("dir"); p.add_argument("--name", default="main")
        p.set_defaults(fn=fn)

    p = sub.add_parser("list"); p.add_argument("dir", nargs="?"); p.set_defaults(fn=cmd_list)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
